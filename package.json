{
  "name": "smart-enterprise-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Management Platform",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "cmd /c \"npm run setup:backend && npm run setup:frontend\"",
    "setup:backend": "cd backend && cmd /c \"npm install\"",
    "setup:frontend": "cd frontend && cmd /c \"npm install\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && cmd /c \"npm run dev\"",
    "dev:frontend": "cd frontend && cmd /c \"npm run dev\"",
    "start": "cd backend && cmd /c \"npm start\"",
    "build": "cd backend && cmd /c \"npm run build\" && cd ../frontend && cmd /c \"npm run build\"",
    "test": "cd backend && cmd /c \"npm run test\"",
    "test:coverage": "cd backend && cmd /c \"npm run test:coverage\""
  },
  "keywords": [
    "enterprise",
    "erp",
    "crm",
    "hr",
    "payroll",
    "project-management"
  ],
  "author": "SmartEnterpriseHub Team"
}
